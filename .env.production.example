# CareerHub — PRODUCTION environment template
# Copy to .env on the VPS and replace EVERY placeholder with real values.
#   cp .env.production.example .env && nano .env
# Never commit the real .env to Git (it is already in .gitignore).

# ---------- Public URLs ----------
# Your real domain — the whole stack is served from here over HTTPS.
# Caddy (reverse proxy) routes:  https://DOMAIN/  -> web,  https://DOMAIN/api/* -> api
DOMAIN=www.example.com
# Email used for Let's Encrypt certificate notices (renewal warnings etc.)
ACME_EMAIL=admin@example.com
# The exact public origin of the web app. Used for CORS and for links inside emails.
WEB_ORIGIN=https://www.example.com
# Optional: base URL used in email buttons (falls back to WEB_ORIGIN).
WEB_URL=https://www.example.com

# ---------- Database ----------
POSTGRES_DB=careerhub
POSTGRES_USER=careerhub
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=<generate-a-long-random-password>

# ---------- Security ----------
# Generate each: openssl rand -hex 32
JWT_ACCESS_SECRET=<generate-a-long-random-access-secret>
JWT_REFRESH_SECRET=<generate-a-long-random-refresh-secret>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- Server ----------
API_PORT=4000

# ---------- Email (nodemailer) ----------
# Leave SMTP_HOST empty to run without emails (safe no-op mode).
# Gmail: smtp.gmail.com : 587 + App Password. Brevo / Mailtrap / SES work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareerHub <no-reply@www.example.com>

# ---------- Payments (Paymob) ----------
# From your Paymob dashboard. Leave empty to keep checkout in dev mode.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
# Register this webhook URL in Paymob: https://DOMAIN/api/v1/billing/paymob/webhook
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# ---------- File uploads ----------
# CV files live in a named Docker volume mounted at this path inside the api container.
UPLOAD_DIR=/app/uploads/resumes
