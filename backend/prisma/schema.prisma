generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING_VERIFICATION
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  HIRED
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  APPLICATION_STATUS
  NEW_APPLICATION
  MESSAGE
  SYSTEM
  NEW_MATCHING_JOB
}

model JobAlert {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  keyword         String?          @db.VarChar(120)
  location        String?          @db.VarChar(120)
  category        String?          @db.VarChar(100)
  experienceLevel ExperienceLevel? @map("experience_level")
  employmentType  EmploymentType?  @map("employment_type")
  workplaceType   WorkplaceType?   @map("workplace_type")
  frequency       AlertFrequency   @default(DAILY) @map("frequency")
  lastRunAt       DateTime?        @map("last_run_at")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("job_alerts")
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY

  @@map("alert_frequency")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  target    String   @db.VarChar(160)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  actor     User     @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique @db.VarChar(255)
  passwordHash        String            @map("password_hash")
  role                Role
  status              UserStatus        @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?         @map("email_verified_at")
  verificationToken   String?           @unique @map("verification_token")
  refreshTokenHash    String?           @map("refresh_token_hash")
  passwordResetToken  String?           @map("password_reset_token")
  passwordResetExpiry DateTime?         @map("password_reset_expiry")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  profile             JobSeekerProfile?
  resumes             Resume[]
  applications        Application[]
  savedJobs           SavedJob[]
  ownedCompanies      Company[]         @relation("CompanyOwner")
  memberships         CompanyMember[]
  notifications       Notification[]
  sentMessages        Message[]         @relation("MessageSender")
  conversations       Conversation[]    @relation("JobSeekerConversations")
  jobAlerts           JobAlert[]
  auditLogs           AuditLog[]        @relation("AuditLogActor")

  @@index([role, status])
  @@map("users")
}

model JobSeekerProfile {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @unique @map("user_id") @db.Uuid
  firstName         String  @default("") @map("first_name")
  lastName          String  @default("") @map("last_name")
  headline          String?
  bio               String? @db.Text
  phone             String?
  location          String?
  yearsOfExperience Int     @default(0) @map("years_of_experience")
  avatarUrl         String? @map("avatar_url")
  skills            Json?   @default("[]")
  experience        Json?   @default("[]")
  education         Json?   @default("[]")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([location])
  @@map("job_seeker_profiles")
}

model Company {
  id                 String                    @id @default(uuid()) @db.Uuid
  ownerId            String                    @map("owner_id") @db.Uuid
  name               String                    @db.VarChar(150)
  slug               String                    @unique @db.VarChar(170)
  description        String?                   @db.Text
  website            String?
  industry           String?
  size               String?
  location           String?
  logoUrl            String?                   @map("logo_url")
  verificationStatus CompanyVerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  owner              User                      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members            CompanyMember[]
  jobs               Job[]
  conversations      Conversation[]
  subscription       Subscription?

  @@index([industry, location])
  @@map("companies")
}

enum PlanTier {
  FREE
  GROWTH
  SCALE

  @@map("plan_tier")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED

  @@map("subscription_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("payment_status")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @unique @map("company_id") @db.Uuid
  plan             PlanTier           @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?          @map("current_period_end")
  paymobOrderId    String?            @map("paymob_order_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments         Payment[]

  @@map("subscriptions")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  subscriptionId      String        @map("subscription_id") @db.Uuid
  amount              Int
  currency            String        @default("EGP") @db.VarChar(3)
  status              PaymentStatus @default(PENDING)
  paymobTransactionId String?       @map("paymob_transaction_id")
  rawPayload          Json?         @map("raw_payload")
  createdAt           DateTime      @default(now()) @map("created_at")
  subscription        Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("payments")
}

model CompanyMember {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  memberRole String  @default("RECRUITER") @map("member_role")
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

model Job {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  title           String          @db.VarChar(180)
  description     String          @db.Text
  requirements    String?         @db.Text
  category        String          @db.VarChar(100)
  location        String?
  employmentType  EmploymentType  @map("employment_type")
  workplaceType   WorkplaceType   @map("workplace_type")
  experienceLevel ExperienceLevel @map("experience_level")
  salaryMin       Int?            @map("salary_min")
  salaryMax       Int?            @map("salary_max")
  currency        String          @default("EGP") @db.VarChar(3)
  status          JobStatus       @default(DRAFT)
  isFeatured      Boolean         @default(false) @map("is_featured")
  viewCount       Int             @default(0) @map("view_count")
  publishedAt     DateTime?       @map("published_at")
  expiresAt       DateTime?       @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications    Application[]
  savedBy         SavedJob[]
  viewDays        JobViewDaily[]

  @@index([status, category, location])
  @@index([companyId, status])
  @@index([companyId, viewCount])
  @@map("jobs")
}

model JobViewDaily {
  id    String   @id @default(uuid()) @db.Uuid
  jobId String   @map("job_id") @db.Uuid
  day   DateTime @db.Date
  count Int      @default(0)
  job   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, day])
  @@index([jobId, day])
  @@map("job_view_daily")
}

model Resume {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  fileName     String        @map("file_name")
  storageKey   String        @unique @map("storage_key")
  mimeType     String        @map("mime_type")
  sizeBytes    Int           @map("size_bytes")
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("resumes")
}

model Application {
  id            String                     @id @default(uuid()) @db.Uuid
  jobId         String                     @map("job_id") @db.Uuid
  userId        String                     @map("user_id") @db.Uuid
  resumeId      String?                    @map("resume_id") @db.Uuid
  coverLetter   String?                    @map("cover_letter") @db.Text
  source        String?                    @map("source") @db.VarChar(50)
  status        ApplicationStatus          @default(SUBMITTED)
  appliedAt     DateTime                   @default(now()) @map("applied_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume        Resume?                    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  history       ApplicationStatusHistory[]
  conversations Conversation[]

  @@unique([jobId, userId])
  @@index([userId, status])
  @@index([jobId, status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  applicationId  String             @map("application_id") @db.Uuid
  previousStatus ApplicationStatus? @map("previous_status")
  status         ApplicationStatus
  note           String?            @db.Text
  changedById    String             @map("changed_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model SavedJob {
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@map("saved_jobs")
}

model Conversation {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  jobSeekerId   String       @map("job_seeker_id") @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobSeeker     User         @relation("JobSeekerConversations", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([companyId, jobSeekerId, applicationId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String       @db.Text
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
