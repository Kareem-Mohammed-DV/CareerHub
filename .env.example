# CareerHub — environment template (development)
# Copy to .env and replace every secret before use:  cp .env.example .env

POSTGRES_DB=careerhub
POSTGRES_USER=careerhub
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-in-production
# Inside Docker Compose the database host is the "postgres" service.
# When running the API outside Docker (npm run dev), replace "postgres" with "localhost".
DATABASE_URL=postgresql://careerhub:change-me-in-production@postgres:5432/careerhub?schema=public

# Generate each: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

API_PORT=4000
# Where the frontend runs (CORS origin + email link base in dev).
WEB_ORIGIN=http://localhost:5173
# Optional explicit web URL for email links (defaults to WEB_ORIGIN).
WEB_URL=http://localhost:5173

# ---- Email (nodemailer) ----
# Leave SMTP_HOST empty to disable emails entirely (safe no-op mode).
# Gmail example: host=smtp.gmail.com port=587 secure=false + an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareerHub <no-reply@careerhub.local>

# ---- Payments (Paymob) ----
# Leave empty to keep billing checkout in dev mode (activation without payment).
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# ---- File uploads ----
# Where CV files are stored inside the api container (mounted Docker volume).
UPLOAD_DIR=/app/uploads/resumes
